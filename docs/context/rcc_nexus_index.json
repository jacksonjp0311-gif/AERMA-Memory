{
  "nci": {
    "components": {
      "completeness": {
        "algorithm": "required_nexus_sections_present / required_nexus_sections",
        "score": 1.0
      },
      "coordinate_completeness": {
        "algorithm": "nodes_with_shell_meridian_sector_ttl / total_nodes",
        "score": 1.0
      },
      "drift_freshness": {
        "algorithm": "1 - geometric_drift_score",
        "score": 0.95
      },
      "evidence_validation_linkage": {
        "algorithm": "records_with_required_evidence_and_validation / required_records",
        "score": 0.9
      },
      "invariant_compliance": {
        "algorithm": "records_preserving_non_claim_locks / total_records",
        "score": 1.0
      },
      "link_correctness": {
        "algorithm": "declared_hooks_resolve_or_are_explicitly_external / declared_hooks",
        "score": 0.9
      },
      "pattern_rigidity": {
        "algorithm": "template_conforming_records / total_records",
        "score": 0.95
      }
    },
    "mode": "self",
    "weights": {
      "completeness": 0.15,
      "coordinate_completeness": 0.15,
      "drift_freshness": 0.1,
      "evidence_validation_linkage": 0.15,
      "invariant_compliance": 0.2,
      "link_correctness": 0.15,
      "pattern_rigidity": 0.1
    }
  },
